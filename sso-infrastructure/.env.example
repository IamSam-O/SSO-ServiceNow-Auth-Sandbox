# Copy this file to .env and fill in all values

# Domain used for OpenLDAP setup (e.g. example.com → dc=example,dc=com)
DOMAIN=yourdomain.com

# Authentik
# Generate with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=
# Create in Authentik UI: Directory → Tokens & App Passwords → Create (Intent: API Token)
# Must be assigned to a regular user (e.g. akadmin) — not an ak-* service account
AUTHENTIK_API_TOKEN=

# PostgreSQL (used by Authentik)
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=changeme

# OpenLDAP
# LDAP_DOMAIN is derived from DOMAIN above by the osixia/openldap image
LDAP_ORGANISATION=Your Organisation
LDAP_ADMIN_PASSWORD=changeme
LDAP_BASE_DN=dc=yourdomain,dc=com
LDAP_ADMIN_DN=cn=admin,dc=yourdomain,dc=com

# ServiceNow — used by scim-refresh
SERVICENOW_INSTANCE=devXXXXXX.service-now.com
# From System OAuth → Application Registry → SCIM API
SERVICENOW_CLIENT_ID=
# Regenerate from the SCIM API registry record before use
SERVICENOW_CLIENT_SECRET=
SERVICENOW_SCIM_USER=svc_authentik
SERVICENOW_SCIM_PASSWORD=

# Internal service URLs — change only if overriding defaults
AUTHENTIK_URL=http://authentik-server:9000
AUTHENTIK_LDAP_SLUG=openldap

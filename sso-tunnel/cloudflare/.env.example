# Copy this file to .env and fill in all values

# Your domain — used to build Cloudflare DNS routes (e.g. example.com)
# Routes in routes.conf should use subdomains of this domain
DOMAIN=example.com

# Name for the Cloudflare Tunnel (visible in the Cloudflare dashboard)
# Use a short, lowercase, hyphenated name (e.g. sso-lab)
# Must not already exist in your Cloudflare account — the entrypoint creates it on first run
TUNNEL_NAME=sso-lab

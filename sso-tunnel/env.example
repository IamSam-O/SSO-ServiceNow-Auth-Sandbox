# =============================================================================
# SSO Tunnel Configuration
# Copy this file to .env and fill in the section for your chosen tunnel.
# =============================================================================

# Choose which tunnel to use: cloudflare | ngrok
TUNNEL_TYPE=cloudflare

# =============================================================================
# Cloudflare Tunnel
# Requires a domain you own with Cloudflare as the DNS provider.
# Provides a stable public URL — configure ServiceNow once.
# =============================================================================

# Your domain (e.g. example.com)
DOMAIN=

# Cloudflare tunnel name
TUNNEL_NAME=

# =============================================================================
# ngrok
# No domain required. Free tier URL changes on every restart.
# =============================================================================

# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Public URL endpoint assigned by ngrok (available in logs after startup)
# On the free tier this changes on every restart — update ServiceNow accordingly
# On a paid plan set a static domain here and it will never change
NGROK_DOMAIN=
